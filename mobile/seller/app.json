{
  "expo": {
    "name": "Novagross Satıcı",
    "slug": "novagross-seller",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "novagross-seller",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.novagross.seller",
      "icon": "./assets/expo.icon",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Fatura ve ürün fotoğrafı çekmek için kameranıza erişilir.",
        "NSPhotoLibraryUsageDescription": "Ürün fotoğrafı ve fatura seçmek için fotoğraflarınıza erişilir.",
        "NSFaceIDUsageDescription": "Hızlı ve güvenli giriş için Face ID kullanılır."
      }
    },
    "android": {
      "package": "com.novagross.seller",
      "adaptiveIcon": {
        "backgroundColor": "#FFF4EC",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#EA580C"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EA580C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
