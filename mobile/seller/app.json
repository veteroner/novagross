{
  "expo": {
    "name": "Novagross Satıcı",
    "slug": "novagross-seller",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "novagross-seller",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.novagross.seller",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Fatura ve ürün fotoğrafı çekmek için kameranıza erişilir.",
        "NSPhotoLibraryUsageDescription": "Ürün fotoğrafı ve fatura seçmek için fotoğraflarınıza erişilir.",
        "NSFaceIDUsageDescription": "Hızlı ve güvenli giriş için Face ID kullanılır.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "29D6U2Z923",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.novagross.seller",
      "adaptiveIcon": {
        "backgroundColor": "#263945",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 1
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#EA580C",
          "enableBackgroundRemoteNotifications": true,
          "icon": "./assets/images/android-icon-monochrome.png"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#263945",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      "./plugins/with-ios-scene-lifecycle"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "veteroner",
    "extra": {
      "eas": {
        "projectId": "4c96b729-9aee-4f07-b4bb-ef181d55d12b"
      }
    }
  }
}
