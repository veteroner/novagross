{
  "expo": {
    "name": "Novagross",
    "slug": "novagross-store",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "novagross",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.novagross.app",
      "supportsTablet": true,
      "appleTeamId": "29D6U2Z923",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.novagross.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 1
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#EA580C",
          "enableBackgroundRemoteNotifications": true,
          "icon": "./assets/images/android-icon-monochrome.png"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      "./plugins/with-ios-scene-lifecycle"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "veteroner",
    "extra": {
      "eas": {
        "projectId": "4f10cd9c-9788-48f6-8f86-c53b0f04397e"
      }
    }
  }
}
